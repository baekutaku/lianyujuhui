  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(45,39,49,.78);
  color: white;
  font-size: 10px;
}

.home-hero-admin-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 9px 2px 5px;

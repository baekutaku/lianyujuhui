  border-radius: 22px;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.52),
      rgba(239,235,250,.38)
    );
  color: #796b80;
  cursor: pointer;
  text-align: center;
}

.home-hero-dropzone .material-symbols-rounded {
  font-size: 34px;
  color: #b58fc0;
}

.home-hero-url-row {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 10px;
}

.home-hero-url-row input {
  min-width: 0;
  min-height: 46px;
  padding: 0 15px;
  border: 1px solid rgba(211,197,220,.72);
  border-radius: 14px;
  background: rgba(255,255,255,.70);
  font: inherit;
}

.home-hero-admin-note {
  color: rgba(103,86,111,.65);
  font-size: 12px;
}

.home-hero-admin-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0,1fr));
  gap: 16px;
}

.home-hero-admin-card {
  min-width: 0;
  padding: 10px;
  border: 1px solid rgba(218,205,225,.68);
  border-radius: 18px;
  background: rgba(255,255,255,.58);
  box-shadow:
    0 8px 24px rgba(88,69,101,.055);
}

.home-hero-admin-card.is-disabled {
  opacity: .55;
}

.home-hero-admin-card.is-dragging {
  opacity: .35;
}

.home-hero-drag-handle {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 8px;

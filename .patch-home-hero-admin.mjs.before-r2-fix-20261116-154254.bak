const cssMarker =
  "HOME HERO ADMIN - 2026-11-16";

if (!css.includes(cssMarker)) {
  css +=
`

/* =========================================================
   ${cssMarker}
========================================================= */

.home-hero-admin {
  display: grid;
  gap: 18px;
}

.home-hero-dropzone {
  min-height: 150px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 7px;
  padding: 24px;

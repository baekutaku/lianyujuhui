}

.home-hero-admin-actions
button.is-danger {
  border-color: rgba(224,170,181,.54);
  color: #a65d6e;
}

@media (max-width: 900px) {
  .home-hero-admin-grid {
    grid-template-columns:
      repeat(2, minmax(0,1fr));
  }
}

@media (max-width: 620px) {
  .home-hero-url-row {
    grid-template-columns: 1fr;
  }

  .home-hero-admin-grid {
    grid-template-columns: 1fr;
  }
